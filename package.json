{
  "name": "youtube-audio-ripper",
  "productName": "YouTube Audio Ripper",
  "version": "1.0.2",
  "description": "Windows desktop app for downloading MP3 clips from YouTube with yt-dlp and ffmpeg.",
  "repository": {
    "type": "git",
    "url": "https://github.com/lkbviking/Youtube-Audio-Ripper.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node scripts/run-tests.js",
    "test:watch": "node scripts/run-tests.js --watch",
    "smoke": "npm run smoke:tools && npm run smoke:start",
    "smoke:start": "node scripts/smoke-start.js",
    "smoke:tools": "node scripts/smoke-tools.js",
    "smoke:clip": "node scripts/smoke-clip.js"
  },
  "devDependencies": {
    "electron": "41.1.1",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
